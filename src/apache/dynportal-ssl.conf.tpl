# ViciBox Dynamic Portal (HTTPS) - generated by vicidial-firewall @@GENERATED@@
# Reference: official/apache/dynportal-ssl.conf from the vicibox-dynportal package.
# Re-running the installer rewrites this file; edit /etc/vicidial-firewall/state only through the installer.
@@LISTEN@@
<VirtualHost _default_:@@PORT@@>
	ServerAdmin admin@@@FQDN@@
	ServerName @@FQDN@@
	DocumentRoot @@DOCROOT@@
	ErrorLog @@LOGDIR@@/dynportal-error_log
	CustomLog @@LOGDIR@@/dynportal-access_log combined
	HostnameLookups Off
	UseCanonicalName Off
	ServerSignature Off
	TraceEnable Off
	DirectoryIndex valid8.php index.php index.html
@@PHP_INCLUDE@@
	# Certificate (Apache 2.4.8+ reads the chain from SSLCertificateFile)
	SSLEngine on
	SSLCertificateFile @@CERT@@
	SSLCertificateKeyFile @@KEY@@
@@CHAIN@@
	SSLProtocol all -SSLv3 -TLSv1 -TLSv1.1
	<FilesMatch "\.(php)$">
		SSLOptions +StdEnvVars
	</FilesMatch>

	# Only the portal page, its stylesheet, its images and the favicon are served
	<Files ~ "^\.ht">
		Require all denied
	</Files>
	<Files "debug.txt">
		Require all denied
	</Files>
	<Directory "@@DOCROOT@@/inc">
		Require all denied
	</Directory>
	<Directory "@@DOCROOT@@">
		Options -Indexes +FollowSymLinks
		AllowOverride None
		Require all granted
	</Directory>

	<IfModule mod_headers.c>
		Header always set X-Frame-Options "DENY"
		Header always set X-Content-Type-Options "nosniff"
		Header always set Referrer-Policy "no-referrer"
		Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; form-action 'self'; frame-ancestors 'none'"
	</IfModule>

	# ViciBox ships a mod_cband profile that rate-limits the portal; it is used only where the module exists
	<IfModule mod_cband.c>
		Include /etc/apache2/conf.d/mod_cband.portal
	</IfModule>
</VirtualHost>
