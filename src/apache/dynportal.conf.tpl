# ViciBox Dynamic Portal (plain HTTP, NOT recommended: agent passwords travel unencrypted)
# generated by vicidial-firewall @@GENERATED@@ because --portal-http was given.
# Reference: official/apache/dynportal.conf from the vicibox-dynportal package.
@@LISTEN@@
<VirtualHost _default_:@@PORT@@>
	ServerAdmin admin@@@FQDN@@
	ServerName @@FQDN@@
	DocumentRoot @@DOCROOT@@
	ErrorLog @@LOGDIR@@/dynportal-error_log
	CustomLog @@LOGDIR@@/dynportal-access_log combined
	HostnameLookups Off
	UseCanonicalName Off
	ServerSignature Off
	TraceEnable Off
	DirectoryIndex valid8.php index.php index.html
@@PHP_INCLUDE@@
	<Files ~ "^\.ht">
		Require all denied
	</Files>
	<Files "debug.txt">
		Require all denied
	</Files>
	<Directory "@@DOCROOT@@/inc">
		Require all denied
	</Directory>
	<Directory "@@DOCROOT@@">
		Options -Indexes +FollowSymLinks
		AllowOverride None
		Require all granted
	</Directory>

	<IfModule mod_headers.c>
		Header always set X-Frame-Options "DENY"
		Header always set X-Content-Type-Options "nosniff"
		Header always set Referrer-Policy "no-referrer"
		Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; form-action 'self'; frame-ancestors 'none'"
	</IfModule>

	<IfModule mod_cband.c>
		Include /etc/apache2/conf.d/mod_cband.portal
	</IfModule>
</VirtualHost>
